<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MdBolsa.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Raw ADO.NET against Npgsql, no EF Core - the same call as the client's
      SQLite indexes (docs/architecture.md's dependency table). The server is a
      thin storage/sync API over one table; a mapping layer would be overhead
      with nothing to map.
    -->
    <PackageReference Include="Npgsql" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The wire contract, shared with the client. See
      docs/decisions/0011-client-sync.md: the server's DTOs used to be its own,
      which was fine until Phase 9 gave the client something to say.
    -->
    <ProjectReference Include="..\..\Shared\MdBolsa.Contracts\MdBolsa.Contracts.csproj" />
  </ItemGroup>

</Project>
