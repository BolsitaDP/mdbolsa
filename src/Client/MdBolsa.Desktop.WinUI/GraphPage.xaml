<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MdBolsa_Desktop_WinUI.GraphPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MdBolsa_Desktop_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Back to notes" Click="OnBackClicked" />
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClicked" />
            <Button Content="Zoom in" Click="OnZoomInClicked" />
            <Button Content="Zoom out" Click="OnZoomOutClicked" />
            <Button x:Name="ResetViewButton" Content="Reset view" Click="OnResetViewClicked" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="ScopeBox" Width="160" SelectionChanged="OnScopeChanged">
                <ComboBoxItem Content="Whole vault" />
                <ComboBoxItem Content="Note and neighbours" />
            </ComboBox>
            <ComboBox x:Name="CenterBox" Width="320" Header="Center note"
                      SelectionChanged="OnCenterChanged" />
            <ComboBox x:Name="DepthBox" Width="120" Header="Depth" SelectionChanged="OnDepthChanged" />
        </StackPanel>

        <TextBlock x:Name="GraphStatusText" Grid.Row="2" VerticalAlignment="Top" Opacity="0.7" />

        <Grid Grid.Row="3" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="1" CornerRadius="4"
                    BorderBrush="#33808080" Background="#0A808080"
                    ManipulationMode="All">
                <Canvas x:Name="GraphCanvas" Background="Transparent"
                        ManipulationDelta="OnCanvasManipulationDelta" />
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="Select a node to see what it is. Drag to pan, wheel to zoom." />
                <Button x:Name="CenterOnSelectionButton" Grid.Column="1" Content="Make center"
                        Click="OnCenterOnSelectionClicked" IsEnabled="False" />
            </Grid>
        </Grid>
    </Grid>
</Page>
