<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MdBolsa_Desktop_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MdBolsa_Desktop_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--
            The graph view (Phase 7) lives in its own Frame *inside* this page
            rather than being navigated to from the root Frame. Navigating the
            root Frame unloads MainPage, and unloading a page holding the Editor
            TextBox reliably crashed the process natively (STATUS_STOWED_EXCEPTION
            0xc000027b) - the same class of failure documented in
            docs/architecture.md's Known Issues. Hosting it here means the editor
            is never torn down; MainContent is just hidden while the graph is up.
        -->
        <Grid x:Name="MainContent" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="VaultPathBox" Width="400" PlaceholderText="Vault folder path" />
            <Button x:Name="BrowseVaultButton" Content="Browse..." Click="OnBrowseVaultClicked" />
            <Button x:Name="OpenVaultButton" Content="Open vault" Click="OnOpenVaultClicked" />
            <Button x:Name="GraphButton" Content="Graph" Click="OnGraphClicked" />
            <Button x:Name="SyncButton" Content="Sync" Click="OnSyncClicked" />
            <Button x:Name="ConflictsButton" Content="Conflicts" Click="OnConflictsClicked" />
            <Button x:Name="SyncSettingsButton" Content="Sync settings..." Click="OnSyncSettingsClicked" />
        </StackPanel>

        <!--
            Sync settings live inline in the page rather than in a dialog: opening
            any XAML popup crashes this build of the Windows App Runtime (see
            docs/architecture.md's Known Issues).
        -->
        <Grid Grid.Row="1" x:Name="SyncSettingsPanel" Visibility="Collapsed" ColumnSpacing="12" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Server URL" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SyncServerBox" Grid.Column="1" PlaceholderText="http://localhost:5080" />
            <PasswordBox x:Name="SyncTokenBox" Grid.Column="2" PlaceholderText="Sync token" />
            <Button Grid.Column="3" Content="Save" Click="OnSaveSyncSettingsClicked" />
        </Grid>
        <!--
            Conflicts are resolved inline, for the same reason sync settings are:
            no dialogs on this runtime. Each row offers the only two honest
            choices - keep this device's copy, or take the server's - and neither
            merges. See docs/decisions/0012-conflict-resolution.md.
        -->
        <StackPanel Grid.Row="2" x:Name="ConflictsPanel" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="Conflicts" FontWeight="SemiBold" />
            <TextBlock x:Name="ConflictsSummaryText" Opacity="0.7" Margin="0,4,0,4" TextWrapping="Wrap" />
            <StackPanel x:Name="ConflictsList" Spacing="4" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,8" Opacity="0.7"
                   Text="Enter a vault folder path above, then click Open vault." />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Width="300" PlaceholderText="Search notes" />
            <Button x:Name="SearchButton" Content="Search" Click="OnSearchClicked" />
            <Button x:Name="ClearSearchButton" Content="Show all notes" Click="OnClearSearchClicked" />
        </StackPanel>

        <Grid Grid.Row="5" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="NewNoteButton" Content="New note" Click="OnNewNoteClicked"
                        HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TagsHeaderText" Opacity="0.7" Text="No tags yet." />
                    <ScrollViewer Grid.Row="1" MaxHeight="140" Margin="0,4,0,0">
                        <StackPanel x:Name="TagsList" Spacing="2" />
                    </ScrollViewer>
                </Grid>

                <ScrollViewer Grid.Row="2">
                    <StackPanel x:Name="NotesList" Spacing="2" />
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="EditorStatusText" VerticalAlignment="Center" Opacity="0.7"
                               Text="Select a note to edit." />
                    <Button x:Name="SaveButton" Grid.Column="1" Content="Save" Click="OnSaveClicked" />
                </Grid>
                <TextBox x:Name="Editor" Grid.Row="1"
                         AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"
                         IsSpellCheckEnabled="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />

                <TextBlock x:Name="NoteMetadataText" Grid.Row="2" Margin="0,8,0,4" Opacity="0.7"
                           TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />

                <TextBlock x:Name="BacklinksHeaderText" Grid.Row="3" Margin="0,8,0,4" Opacity="0.7" />
                <ScrollViewer Grid.Row="4" MaxHeight="160">
                    <StackPanel x:Name="BacklinksList" Spacing="2" />
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>

        <Frame x:Name="GraphHost" Visibility="Collapsed" />
    </Grid>
</Page>
